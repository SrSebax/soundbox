{
  "name": "soundbox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Descarga audio de YouTube en MP3 desde el navegador (yt-dlp + FFmpeg).",
  "scripts": {
    "postinstall": "node scripts/setup.mjs",
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/py.mjs server.py",
    "dev:web": "vite",
    "build": "vite build",
    "start": "vite build && node scripts/py.mjs server.py --open",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
